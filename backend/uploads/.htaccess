# Protecção da pasta de comprovativos e ficheiros enviados (/backend/uploads)
# Impede a execução de scripts PHP ou executáveis enviados por utilizadores
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
php_flag engine off
<FilesMatch "\.(php|phtml|phar|sh|pl|py|cgi|htaccess)$">
  Require all denied
</FilesMatch>
