<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  DirectoryIndex index.html

  # Servir ficheiros e pastas existentes directamente
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Encaminhar todas as restantes rotas SPA para index.html
  RewriteRule ^ index.html [L]
</IfModule>
